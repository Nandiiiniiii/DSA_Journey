class Solution {   
    public boolean rotateString(String s, String goal) {
        //your code goes here
        if(s.length()!=goal.length())
        return false;
        for(int i=0;i<s.length()-1;i++)
        {
            String right=s.substring(i)+s.substring(0,i);
            if(right.equals(goal))
            {
            return true;
            }
        }
        return false;
    }
}
